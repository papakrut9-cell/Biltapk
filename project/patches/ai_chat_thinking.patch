+/**
+ * Variant of chat_add_and_format() that applies the chat template via jinja with
+ * extra template kwargs (e.g. enable_thinking=false). Falls back to the caller:
+ * any exception from the jinja renderer propagates so the code can re-format
+ * through the legacy path.
+ */
+static std::string chat_add_and_format_thinking(const std::string &role,
+                                                const std::string &content,
+                                                const std::map<std::string, std::string> &chat_template_kwargs) {
+    common_chat_msg new_msg;
+    new_msg.role = role;
+    new_msg.content = content;
+
+    common_chat_templates_inputs inputs;
+    inputs.use_jinja            = true;
+    inputs.chat_template_kwargs = chat_template_kwargs;
+    // common_chat_templates is incomplete in this TU (common/chat.h only
+    // forward-declares it), so add_bos/add_eos come from the vocab — exactly
+    // how common_chat_templates_init() fills them in common/chat.cpp.
+    {
+        const auto * vocab = g_model ? llama_model_get_vocab(g_model) : nullptr;
+        inputs.add_bos     = vocab ? llama_vocab_get_add_bos(vocab) : false;
+        inputs.add_eos     = vocab ? llama_vocab_get_add_eos(vocab) : false;
+    }
+
+    std::string fmt_past_msg;
+    if (!chat_msgs.empty()) {
+        inputs.messages              = chat_msgs;
+        inputs.add_generation_prompt = false;
+        fmt_past_msg                 = common_chat_templates_apply(g_chat_templates.get(), inputs).prompt.str();
+    }
+    std::ostringstream ss;
+    if (role == ROLE_USER && !fmt_past_msg.empty() && fmt_past_msg.back() == '\n') {
+        ss << "\n";
+    }
+    inputs.messages.push_back(new_msg);
+    inputs.add_generation_prompt = (role == ROLE_USER);
+    auto fmt_new_msg             = common_chat_templates_apply(g_chat_templates.get(), inputs).prompt.str();
+    ss << fmt_new_msg.substr(fmt_past_msg.size(), fmt_new_msg.size() - fmt_past_msg.size());
+    chat_msgs.push_back(new_msg);
+    LOGi("%s: Formatted and added %s message: \n%s\n", __func__, role.c_str(), ss.str().c_str());
+    return ss.str();
+}
+
